# Email service (Resend) — get a free key at resend.com
RESEND_API_KEY=

# Where booking notifications are sent
BOOKING_NOTIFICATION_EMAIL=mo.taoufiq@googlemail.com

# WhatsApp Business number — international format, no + or spaces (e.g. Morocco: 212612345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# ─── Payment links (Tap Payments) ────────────────────────────────────────────
# Create one Payment Link per package on tap.company with the amount pre-filled.
# If a specific link is missing, the site falls back to NEXT_PUBLIC_PAYMENT_LINK.

# Generic fallback
NEXT_PUBLIC_PAYMENT_LINK=https://checkout.tap.company/your-default-link

# LinkedIn track
NEXT_PUBLIC_PAYMENT_LINKEDIN_STARTER=https://checkout.tap.company/linkedin-150dh
NEXT_PUBLIC_PAYMENT_LINKEDIN_PRO=https://checkout.tap.company/linkedin-300dh
NEXT_PUBLIC_PAYMENT_LINKEDIN_PREMIUM=https://checkout.tap.company/linkedin-500dh

# Career track
NEXT_PUBLIC_PAYMENT_CAREER_STARTER=https://checkout.tap.company/career-300dh
NEXT_PUBLIC_PAYMENT_CAREER_PRO=https://checkout.tap.company/career-500dh
